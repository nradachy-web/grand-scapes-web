---
/* The form alone, for buttons on pages without a quote band. On a phone the form
   is the first thing after the title. No sticky bar: this page IS the action. */
import Base from '../layouts/Base.astro';
import QuoteBand from '../components/QuoteBand.astro';
import { breadcrumbs } from '../lib/schema';

const path = '/get-an-estimate/';
---

<Base
  title="Get a Free Lawn, Landscape or Snow Estimate | Grand Scapes"
  description="Tell us about the property and Rob will take a look. Free estimates for mowing, beds, cleanups and snow across Grand Blanc and Genesee County."
  path={path}
  bare
  schema={[breadcrumbs([{ name: 'Home', path: '/' }, { name: 'Free estimate', path }])]}
>
  <h1 class="sr">Get a free estimate from Grand Scapes</h1>
  <QuoteBand from="ink" eyebrow="Free estimate" title="Tell us about the property." lede="It takes a minute. Rob reaches out, comes out to look at it with you and gives you a free estimate, with no pressure either way." />
</Base>
