---
/* Where a sent form lands. Counted as a lead. Never in the sitemap. */
import Base from '../layouts/Base.astro';
import PageHead from '../components/PageHead.astro';
import Icon from '../components/Icon.astro';
import { BRAND } from '../data/site';
import { href } from '../lib/paths';
---

<Base title="Thanks, we got your request | Grand Scapes" description="Your estimate request reached Grand Scapes. Rob will be in touch to set up a time to look at the property with you." path="/thank-you/" quoteHref="/get-an-estimate/" noindex bare lead>
  <PageHead eyebrow="Request received" title="Got it. **Rob will be in touch.**" lede="Your request is on its way to Rob. Want to speed things up? Text a photo or two of the yard or the driveway to the same number." next="ink">
    <div class="actions">
      <a class="btn primary" href={BRAND.smsHref} data-loc="thanks-text"><Icon name="text" />Text a photo</a>
      <a class="btn ghost" href={href('/our-work/')}>See our work</a>
    </div>
  </PageHead>
</Base>
