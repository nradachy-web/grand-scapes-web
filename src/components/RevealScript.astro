---
/* The drag to reveal panels, once per page. Nothing runs until a panel's "before"
   picture has loaded, and that picture is lazy, so a panel far down the page costs
   nothing. The sparks of leaf, water and bits are a second canvas that only animates
   while there are some in the air. */
---

<script is:inline>
  (function () {
    var FX = {
      mow: { r: 0.07, tint: ['#6fae3a', '#8cc94f', '#4f8f2a', '#a9d86a'], n: 7, size: [2, 5], up: 3.2, g: 0.17, out: 3.8, life: 46, leaf: true },
      snow: { r: 0.075, tint: ['#ffffff', '#eef4fb', '#dfe9f3', '#f7fbff'], n: 10, size: [1.4, 3.6], up: 3.8, g: 0.14, out: 4.8, life: 40, cols: true },
      leaf: { r: 0.085, tint: ['#d9672b', '#e8a13a', '#b8391f', '#f0c04a'], n: 4, size: [5, 10], up: 3.2, g: 0.08, out: 4.4, life: 70, leaf: true },
    };
    var still = matchMedia('(prefers-reduced-motion: reduce)').matches;

    document.querySelectorAll('.rp:not([data-on])').forEach(function (root) {
      root.setAttribute('data-on', '');
      var src = root.querySelector('.rp__src img');
      var shown = root.querySelector('.rp__stage > picture:not(.rp__src) img');
      var paint = root.querySelector('.rp__paint');
      var fx = root.querySelector('.rp__fx');
      var btn = root.querySelector('.rp__btn');
      var note = root.querySelector('.rp__note');
      var cfg = FX[root.dataset.kind];
      var ctx, sparks, W, H, last, down = false, sprites = [], live = false, frame = 0, mask = null, box0 = null;
      var probe = document.createElement('canvas');
      probe.width = 48;
      probe.height = 32;
      var pctx = probe.getContext('2d', { willReadFrequently: true });

      /* Draw a picture the way object-fit: cover shows it, so the paint lines up with the
         photo at any shape of frame (a phone shows the panel taller). */
      function cover(c, img, w, h) {
        /* only the ratio: a srcset picture reports its size in CSS pixels, not the file's */
        var r = img.naturalWidth / img.naturalHeight, dw = Math.max(w, h * r), dh = dw / r;
        c.drawImage(img, (w - dw) / 2, (h - dh) / 2, dw, dh);
      }

      /* Which parts of the picture actually change (the lawn, the driveway), on the same
         48 by 32 grid the progress check reads. Done means those parts are clear, so a
         driveway can be finished without scrubbing the sky. */
      function measure() {
        if (mask || !(shown.complete && shown.naturalWidth)) return;
        try {
          var a = document.createElement('canvas'), b = document.createElement('canvas');
          a.width = b.width = 48;
          a.height = b.height = 32;
          var ac = a.getContext('2d', { willReadFrequently: true }), bc = b.getContext('2d', { willReadFrequently: true });
          cover(ac, shown, 48, 32);
          cover(bc, src, 48, 32);
          var da = ac.getImageData(0, 0, 48, 32).data, db = bc.getImageData(0, 0, 48, 32).data, m = [], x0 = 48, x1 = 0, y0 = 32, y1 = 0;
          for (var i = 0; i < 1536; i++) {
            var j = i * 4, d = (Math.abs(da[j] - db[j]) + Math.abs(da[j + 1] - db[j + 1]) + Math.abs(da[j + 2] - db[j + 2])) / 3;
            if (d > 16) {
              m.push(i);
              x0 = Math.min(x0, i % 48); x1 = Math.max(x1, i % 48);
              y0 = Math.min(y0, (i / 48) | 0); y1 = Math.max(y1, (i / 48) | 0);
            }
          }
          if (m.length > 60) {
            mask = m;
            box0 = [x0 / 48, y0 / 32, (x1 + 1) / 48, (y1 + 1) / 32];
          }
        } catch (e) {}
      }

      function reset() {
        ctx.globalCompositeOperation = 'source-over';
        cover(ctx, src, W, H);
        ctx.globalCompositeOperation = 'destination-out';
        root.classList.remove('done');
        note.textContent = '';
        btn.textContent = root.dataset.auto;
        live = true;
      }

      function start() {
        if (W) return;
        var box = paint.getBoundingClientRect();
        var dpr = Math.min(devicePixelRatio || 1, 2);
        W = paint.width = fx.width = Math.round(box.width * dpr);
        H = paint.height = fx.height = Math.round(box.height * dpr);
        ctx = paint.getContext('2d');
        sparks = fx.getContext('2d');
        reset();
        btn.hidden = false;
        root.classList.add('ready');
      }

      function stamp(x, y) {
        var r = W * cfg.r;
        var g = ctx.createRadialGradient(x, y, r * 0.78, x, y, r);
        g.addColorStop(0, 'rgba(0,0,0,1)');
        g.addColorStop(1, 'rgba(0,0,0,0)');
        ctx.fillStyle = g;
        ctx.beginPath();
        ctx.arc(x, y, r, 0, 7);
        ctx.fill();
      }

      function spray(x, y) {
        if (still || sprites.length > 150) return;
        for (var i = 0; i < cfg.n; i++) {
          sprites.push({
            x: x + (Math.random() - 0.5) * W * cfg.r,
            y: y + (Math.random() - 0.5) * W * cfg.r * 0.6,
            vx: (Math.random() - 0.5) * cfg.out * (W / 640),
            vy: -Math.random() * cfg.up * (W / 640),
            size: (cfg.size[0] + Math.random() * (cfg.size[1] - cfg.size[0])) * (W / 900),
            spin: Math.random() * 6,
            turn: (Math.random() - 0.5) * 0.25,
            life: cfg.life * (0.6 + Math.random() * 0.4),
            tint: cfg.tint[(Math.random() * cfg.tint.length) | 0],
          });
        }
        if (!frame) frame = requestAnimationFrame(tick);
      }

      function tick() {
        sparks.clearRect(0, 0, W, H);
        sprites = sprites.filter(function (s) { return s.life > 0; });
        sprites.forEach(function (s) {
          s.vy += cfg.g * (W / 640);
          s.x += s.vx;
          s.y += s.vy;
          s.spin += s.turn;
          s.life -= 1;
          sparks.globalAlpha = Math.min(1, s.life / 14);
          sparks.fillStyle = s.tint;
          sparks.beginPath();
          if (cfg.leaf) sparks.ellipse(s.x, s.y, s.size, s.size * 0.5, s.spin, 0, 7);
          else sparks.arc(s.x, s.y, s.size, 0, 7);
          sparks.fill();
        });
        frame = sprites.length ? requestAnimationFrame(tick) : 0;
        if (!frame) sparks.clearRect(0, 0, W, H);
      }

      function sweep(x, y) {
        if (last) {
          var dx = x - last[0], dy = y - last[1];
          var step = Math.max(1, Math.round(Math.hypot(dx, dy) / (W * cfg.r * 0.3)));
          for (var i = 1; i <= step; i++) stamp(last[0] + (dx * i) / step, last[1] + (dy * i) / step);
        } else stamp(x, y);
        last = [x, y];
        spray(x, y);
      }

      function finish() {
        if (!live) return;
        live = false;
        root.classList.add('done', 'used');
        btn.disabled = false;
        note.textContent = root.dataset.done;
        btn.textContent = 'Start over';
      }

      /* How much is left, read from a thumbnail so it never costs a frame. */
      function check() {
        if (!live) return;
        pctx.clearRect(0, 0, 48, 32);
        pctx.drawImage(paint, 0, 0, 48, 32);
        var d = pctx.getImageData(0, 0, 48, 32).data, left = 0;
        measure();
        if (mask) {
          for (var k = 0; k < mask.length; k++) if (d[mask[k] * 4 + 3] > 60) left++;
          if (left / mask.length < 0.1) finish();
          return;
        }
        for (var i = 3; i < d.length; i += 4) if (d[i] > 60) left++;
        if (left / 1536 < 0.07) finish();
      }

      /* Passes over the part that changes: across the lawn row by row, or up and down
         the driveway the way a plow truck runs it. */
      function auto() {
        root.classList.add('used');
        if (still) return finish();
        btn.disabled = true;
        measure();
        var t = 0, b = box0 || [0, 0, 1, 1], bw = (b[2] - b[0]) * W, bh = (b[3] - b[1]) * H, r = W * cfg.r;
        var cols = !!cfg.cols, rows = Math.max(2, Math.ceil((cols ? bw : bh) / (r * 1.5))), total = Math.round(rows * (cols ? 16 : 19));
        function run() {
          var p = t / total, row = Math.min(rows - 1, Math.floor(p * rows)), q = p * rows - row, along = row % 2 ? q : 1 - q, across = (row + 0.5) / rows;
          if (cols) sweep(b[0] * W + across * bw, b[1] * H + along * bh);
          else sweep(b[0] * W + (1 - along) * bw, b[1] * H + across * bh);
          t += 1;
          if (t <= total && live) requestAnimationFrame(run);
          else { last = null; finish(); }
        }
        last = null;
        run();
      }

      function at(e) {
        var box = paint.getBoundingClientRect();
        return [((e.clientX - box.left) / box.width) * W, ((e.clientY - box.top) / box.height) * H];
      }
      paint.addEventListener('pointerdown', function (e) {
        if (!W || !live) return;
        down = true;
        last = null;
        root.classList.add('used');
        var p = at(e);
        sweep(p[0], p[1]);
      });
      paint.addEventListener('pointermove', function (e) {
        if (!down) return;
        var p = at(e);
        sweep(p[0], p[1]);
      });
      function up() {
        if (down) check();
        down = false;
      }
      addEventListener('pointerup', up);
      addEventListener('pointercancel', up);
      setInterval(function () { if (down) check(); }, 260);

      btn.addEventListener('click', function () {
        if (live) auto();
        else reset();
      });

      if (src.complete && src.naturalWidth) start();
      else src.addEventListener('load', start);
    });
  })();
</script>
