---
/* Where Grand Scapes works, on a real map: I-75 and US-23 drawn from
   coordinates, the shop on Embury Road, and every town a point of lawn green that
   links to its page. The text list of towns stays on the page beside it for
   search engines and screen readers. */
import { CITIES, hubPath } from '../data/cities';
import { BRAND } from '../data/site';
import { href } from '../lib/paths';

const POS: Record<string, [number, number]> = {
  'grand-blanc': [42.9275, -83.6299], fenton: [42.7978, -83.7049], linden: [42.8145, -83.7827], holly: [42.792, -83.6277],
  goodrich: [42.917, -83.5066], ortonville: [42.8523, -83.443], clarkston: [42.7359, -83.4188], flint: [43.0125, -83.6875],
  'flint-township': [43.003, -83.775], 'mundy-township': [42.9417, -83.7322], 'swartz-creek': [42.9573, -83.8305],
  burton: [42.9995, -83.6163], davison: [43.0347, -83.518],
};
/* the few that stay labeled on a phone */
const PHONE = ['grand-blanc', 'fenton', 'flint', 'davison', 'clarkston', 'holly', 'swartz-creek', 'goodrich'];
const LEFT = ['clarkston'];

const W = 960, H = 900;
const LAT0 = 43.05, LON0 = -83.86, SX = 2000, SY = SX * 1.364;
const xy = (lat: number, lon: number): [number, number] => [Math.round((lon - LON0) * SX), Math.round((LAT0 - lat) * SY)];
const path = (pts: [number, number][]) => pts.map(([a, b], i) => `${i ? 'L' : 'M'}${xy(a, b).join(' ')}`).join('');

const i75 = path([[43.07, -83.76], [43.02, -83.722], [42.97, -83.692], [42.92, -83.664], [42.87, -83.635], [42.82, -83.596], [42.78, -83.53], [42.75, -83.46], [42.72, -83.39]]);
const us23 = path([[43.07, -83.795], [43.0, -83.772], [42.93, -83.755], [42.86, -83.74], [42.8, -83.735], [42.72, -83.73]]);
const shop = xy(BRAND.geo.lat, BRAND.geo.lng);
const towns = CITIES.filter((c) => POS[c.id]).map((c) => {
  const [x, y] = xy(POS[c.id][0], POS[c.id][1]);
  return { c, x, y, phone: PHONE.includes(c.id), left: LEFT.includes(c.id) };
});
---

<figure class="am">
  <svg viewBox={`0 0 ${W} ${H}`} role="group" aria-label={`Map of the towns ${BRAND.name} serves around Grand Blanc, from Flint and Davison to Fenton, Holly and Clarkston`}>
    <defs>
      <radialGradient id="am-g"><stop offset="0" stop-color="#a5e27f" stop-opacity="0.9" /><stop offset="0.35" stop-color="#84d455" stop-opacity="0.26" /><stop offset="1" stop-color="#84d455" stop-opacity="0" /></radialGradient>
      <pattern id="am-grid" width="48" height="48" patternUnits="userSpaceOnUse"><path d="M48 0H0V48" fill="none" stroke="rgb(226 234 228 / 0.05)" stroke-width="1" /></pattern>
    </defs>
    <rect width={W} height={H} fill="url(#am-grid)" />
    <path class="am__road" d={i75} />
    <path class="am__road am__road--b" d={us23} />
    <text class="am__tag" x="96" y="62">US-23</text>
    <text class="am__tag" x="410" y="40">I-75</text>
    <g class="am__shop" aria-hidden="true">
      <circle cx={shop[0]} cy={shop[1]} r="30" class="am__ring" />
      <rect x={shop[0] - 7} y={shop[1] - 7} width="14" height="14" rx="2" class="am__pin" transform={`rotate(45 ${shop[0]} ${shop[1]})`} />
      <text class="am__n am__n--shop" x={shop[0] - 16} y={shop[1] + 34} text-anchor="end">Our shop</text>
    </g>
    {
      towns.map((t) => (
        <a href={href(hubPath(t.c))} class="am__t" aria-label={t.c.name}>
          <circle class="am__hit" cx={t.x} cy={t.y} r="22" />
          <circle class="am__glow" cx={t.x} cy={t.y} r="20" fill="url(#am-g)" />
          <circle class="am__dot" cx={t.x} cy={t.y} r="5" />
          <text class:list={['am__n', !t.phone && 'am__n--wide']} text-anchor={t.left ? 'end' : undefined} x={t.left ? t.x - 12 : t.x + 12} y={t.y + 5}>{t.c.name}</text>
        </a>
      ))
    }
  </svg>
  <figcaption class="note cap">Each point is a town we work in, and the diamond is our shop on Embury Road. Pick a town to see its page, or use the list.</figcaption>
</figure>

<style>
  .am svg {
    width: 100%;
    height: auto;
    border: 1px solid var(--line-ink);
    border-radius: var(--r);
    background: var(--ink-2);
  }

  .am__road {
    fill: none;
    stroke: rgb(201 207 208 / 0.36);
    stroke-width: 2.5;
    stroke-linecap: round;
    stroke-linejoin: round;
  }

  .am__road--b {
    stroke-dasharray: 3 7;
  }

  .am__tag {
    fill: rgb(201 207 208 / 0.6);
    font: 700 15px var(--font);
    letter-spacing: 0.08em;
  }

  .am__ring {
    fill: none;
    stroke: rgb(132 212 85 / 0.45);
    stroke-width: 1.5;
    stroke-dasharray: 4 5;
  }

  .am__pin {
    fill: var(--lime);
  }

  .am__hit {
    fill: transparent;
  }

  .am__dot {
    fill: #dff5cc;
    transition: r 0.15s var(--ease);
  }

  .am__n {
    fill: var(--on-ink);
    font: 560 17px var(--font);
    paint-order: stroke;
    stroke: var(--ink-2);
    stroke-width: 4px;
  }

  .am__n--shop {
    fill: var(--lime-soft);
    font-weight: 700;
  }

  .am__t:hover .am__dot,
  .am__t:focus-visible .am__dot {
    fill: var(--lime);
  }

  .am__t:hover .am__n,
  .am__t:focus-visible .am__n {
    fill: var(--lime);
  }

  @media (max-width: 39.99rem) {
    .am__n {
      font-size: 30px;
      stroke-width: 6px;
    }

    .am__n--wide {
      display: none;
    }

    .am__dot {
      r: 9px;
    }

    .am__hit {
      r: 32px;
    }

    .am__glow {
      r: 32px;
    }

    .am__tag {
      font-size: 24px;
    }
  }
</style>
